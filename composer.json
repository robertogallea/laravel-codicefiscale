{
    "name": "robertogallea/laravel-codicefiscale",
    "description": "Codice fiscale validation for php/laravel",
    "type": "library",
    "authors": [
        {
            "name": "Roberto Gallea",
            "email": "write@robertogallea.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.0",
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^10.1",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "fakerphp/faker": "^1.20"
    },
    "suggest": {
        "fakerphp/faker": "Required to use CodiceFiscaleProvider (^1.20)."
    },
	"autoload": {
        "psr-4": {
            "Robertogallea\\CodiceFiscale\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Robertogallea\\CodiceFiscale\\Laravel\\CodiceFiscaleServiceProvider"
            ]
        }
    }
}
